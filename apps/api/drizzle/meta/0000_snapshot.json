  "views": {
    "public.v_false_alarm_percentage": {
      "columns": {
        "false_positive_count": {
          "name": "false_positive_count",
          "type": "bigint",
          "primaryKey": false,
          "notNull": true
        },
        "confirmed_count": {
          "name": "confirmed_count",
          "type": "bigint",
          "primaryKey": false,
          "notNull": true
        },
        "false_alarm_percentage": {
          "name": "false_alarm_percentage",
          "type": "numeric",
          "primaryKey": false,
          "notNull": true
        }
      },
      "definition": "\n  SELECT\n    count(*) FILTER (WHERE review_status = 'false_positive') AS false_positive_count,\n    count(*) FILTER (WHERE review_status = 'confirmed') AS confirmed_count,\n    coalesce(\n      round(\n        100.0 * count(*) FILTER (WHERE review_status = 'false_positive')\n        / nullif(count(*) FILTER (WHERE review_status IN ('confirmed', 'false_positive')), 0),\n        2\n      ),\n      0\n    ) AS false_alarm_percentage\n  FROM public.incidents\n",
      "name": "v_false_alarm_percentage",
      "schema": "public",
      "isExisting": false,
      "materialized": false
    },
    "public.v_incidents_by_category": {
      "columns": {
        "category_id": {
          "name": "category_id",
          "type": "integer",
          "primaryKey": false,
          "notNull": true
        },
        "category_code": {
          "name": "category_code",
          "type": "varchar(40)",
          "primaryKey": false,
          "notNull": true
        },
        "category_name": {
          "name": "category_name",
          "type": "varchar(100)",
          "primaryKey": false,
          "notNull": true
        },
        "severity_level": {
          "name": "severity_level",
          "type": "severity_level",
          "typeSchema": "public",
          "primaryKey": false,
          "notNull": true
        },
        "total_incidents": {
          "name": "total_incidents",
          "type": "bigint",
          "primaryKey": false,
          "notNull": true
        }
      },
      "definition": "\n  SELECT c.id AS category_id, c.code AS category_code, c.name AS category_name,\n         c.severity_level, count(i.id) AS total_incidents\n  FROM public.incident_categories AS c\n  LEFT JOIN public.incidents AS i\n    ON i.category_id = c.id AND i.review_status <> 'system_test'\n  GROUP BY c.id, c.code, c.name, c.severity_level\n",
      "name": "v_incidents_by_category",
      "schema": "public",
      "isExisting": false,
      "materialized": false
    },
    "public.v_incidents_by_hour": {
      "columns": {
        "hour_bucket": {
          "name": "hour_bucket",
          "type": "timestamp with time zone",
          "primaryKey": false,
          "notNull": true
        },
        "total_incidents": {
          "name": "total_incidents",
          "type": "bigint",
          "primaryKey": false,
          "notNull": true
        }
      },
      "definition": "\n  SELECT date_trunc('hour', occurred_at) AS hour_bucket, count(*) AS total_incidents\n  FROM public.incidents\n  WHERE review_status <> 'system_test'\n  GROUP BY date_trunc('hour', occurred_at)\n",
      "name": "v_incidents_by_hour",
      "schema": "public",
      "isExisting": false,
      "materialized": false
    }
  },
