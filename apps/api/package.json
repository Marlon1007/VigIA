{
  "name": "@vigia/api",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js"
  },
  "nx": {
    "targets": {
      "build": {
        "cache": true,
        "outputs": [
          "{projectRoot}/dist"
        ]
      },
      "start": {
        "dependsOn": [
          "build"
        ],
        "continuous": true
      }
    }
  },
  "dependencies": {
    "@nestjs/common": "11.2.11",
    "@nestjs/core": "11.2.11",
    "@nestjs/platform-express": "11.2.11",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3"
  }
}
